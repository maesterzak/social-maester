# Copy to .env and fill in only the platforms you use. Restart the app after editing.

# 1 = make the pictures/videos but don't send anything (safe testing)
DRY_RUN=1

# Branding on the post pictures and captions
BRAND_NAME=PathMaester
BRAND_HASHTAG=PathMaester
# PathMaester: jobs/scholarships are read (read-only) from its database; posts link to its public pages.
# Leave PATHMAESTER_DATABASE_URL empty to use the local sample jobs instead.
PATHMAESTER_DATABASE_URL=
PATHMAESTER_URL=https://pathmaester.netlify.app

# Address the platforms send you back to after login. Register <APP_URL>/api/connect/<id>/callback in each app
# (the Accounts page shows the exact URLs). TikTok needs https (tunnel or deployed site).
APP_URL=http://127.0.0.1:3011

# Optional: full path to ffmpeg if it isn't on PATH
FFMPEG_PATH=

# ---- Developer apps (needed for the Connect buttons) ----
# Account tokens come from Connect and are stored in data/social.db (gitignored).
# The account-level keys further down are an optional alternative to Connect.

# X (Twitter) app: API Key + Secret (consumer keys), permissions Read and write
X_API_KEY=
X_API_SECRET=
# Meta app (Facebook Page + Instagram)
META_APP_ID=
META_APP_SECRET=
# LinkedIn app
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- Optional: account keys instead of Connect ----
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Facebook Page
FB_PAGE_ID=
FB_PAGE_TOKEN=
META_GRAPH_VERSION=v23.0

# Instagram Reels (professional account linked to the Facebook Page)
IG_USER_ID=
IG_ACCESS_TOKEN=

# TikTok Content Posting API (Direct Post)
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY until TikTok audits the app; then e.g. PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# LinkedIn (author: urn:li:person:xxx or urn:li:organization:123)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202510

# Telegram channel (bot must be a channel admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# YouTube Shorts (set by the Connect button; privacy: public, unlisted or private)
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public
